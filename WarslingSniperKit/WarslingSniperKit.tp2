COPY_EXISTING ~kitlist.2da~ ~override~
	COUNT_2DA_ROWS ~9~ "rows"
		FOR ( index = 31 ; index < rows ; index = index + 1 ) BEGIN
			READ_2DA_ENTRY "%index%" 5 9 "clab"
				PATCH_IF ("%clab%" STRING_COMPARE_CASE "%kit_name%" = 0) BEGIN
			READ_2DA_ENTRY "%index%" 0 9 "%kit_name%"
					SET "rows" = 0
				END
		END
BUT_ONLY_IF_IT_CHANGES


ACTION_IF GAME_IS ~bgee bg2ee eet~ BEGIN

		OUTER_SET kit_Montaron = kit_id // A0WS_FT

END ELSE BEGIN

		OUTER_SET kit_Montaron = "%A0WS%"

			// Borrowed from Tweak Anthology by Camdawg

		OUTER_SET proficiency_sling = 5

	COPY_EXISTING ~weapprof.2da~ ~override~ // FIGHTER_THIEF
		REPLACE_TEXTUALLY ~^\(SLING[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+\)[^ %TAB%]+~
			~\1%proficiency_sling%~
	IF_EXISTS

END

//	Regular / TDD / BG1NPCSoA
ACTION_FOR_EACH creature IN
	MONTAR MONTAR2 MONTAR4 MONTAR6 MONTYRA2 7XCRE74
						BEGIN

	ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN
		PRINT ~Montaron Exists~
			COPY_EXISTING ~%creature%.cre~ ~override~
				WRITE_SHORT 0x244 0
				WRITE_SHORT 0x246 0x4000 + kit_Montaron
			BUT_ONLY

	END
END

