		OUTER_SET kit_class = 9   // FIGHTER_THIEF
			OUTER_SPRINT kit_name ~A0WS_FT~ // FIGHTER_THIEF
				OUTER_SPRINT base_class ~F~ // FIGHTER
					OUTER_SPRINT kittable ~K_FT_H   K_FT_D  K_FT_G  K_FT_E  K_FT_HE  K_FT_HL  K_FT_H~ // FIGHTER_THIEF table
						OUTER_SPRINT luabbr ~FT0~ // FIGHTER_THIEF table

