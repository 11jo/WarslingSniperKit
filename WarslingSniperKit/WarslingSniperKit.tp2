BACKUP ~weidu_external/WarslingSniperKit/backup~

AUTHOR ~adul@adul.net~

README ~WarslingSniperKit/readme/Readme.%LANGUAGE%.txt~ ~WarslingSniperKit/readme/Readme.english.txt~

VERSION ~v3.0~

ALWAYS

	DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
	COPY ~WarslingSniperKit/tra/english~				~weidu_external/WarslingSniperKit/tra/autotra/%LANGUAGE%~
	COPY ~WarslingSniperKit/tra/%LANGUAGE%~				~weidu_external/WarslingSniperKit/tra/autotra/%LANGUAGE%~
	END

	LAF autotra_workaround END

	ACTION_IF NOT GAME_IS ~bgee bg2ee eet~ BEGIN

//			ACTION_DEFINE_ARRAY AD_noconvert BEGIN END

		ACTION_DEFINE_ARRAY AD_reload BEGIN Setup END
			LAF HANDLE_CHARSETS
				INT_VAR
				infer_charsets = 1
				from_utf8      = 1
				STR_VAR
				tra_path = EVAL ~weidu_external/WarslingSniperKit/tra/autotra~
				out_path = EVAL ~weidu_external/WarslingSniperKit/tra/autotra~
				iconv_path = ~WarslingSniperKit/tra/autotra/iconv~
//				noconvert_array = AD_noconvert
				reload_array = AD_reload
			END

	END
END

AUTO_TRA ~weidu_external/WarslingSniperKit/tra/autotra/%s~

LANGUAGE ~English~
		 ~english~
		 ~WarslingSniperKit/tra/english/setup.tra~

LANGUAGE ~Francais~
		 ~french~
		 ~WarslingSniperKit/tra/french/setup.tra~

BEGIN @4
DESIGNATED 0
LABEL ~Adam_Zsoldos_WarslingSniperKit~
SUBCOMPONENT @0  //Warsling Sniper Kit for Fighters
REQUIRE_PREDICATE GAME_IS ~tob bgee iwdee bg2ee eet bgt~ @5

OUTER_SET WarslingSniperKit = 0

INCLUDE ~WarslingSniperKit/lib/WarslingSniperKit.tpa~


BEGIN @6
DESIGNATED 1
LABEL ~Adam_Zsoldos_WarslingSniperKit-Pourcentage~
SUBCOMPONENT @0
REQUIRE_PREDICATE GAME_IS ~bgee iwdee eet bgt~ @5

OUTER_SET WarslingSniperKit = 1

INCLUDE ~WarslingSniperKit/lib/WarslingSniperKit.tpa~


BEGIN @7
DESIGNATED 2
LABEL ~Adam_Zsoldos_WarslingSniperKit-Multi~
SUBCOMPONENT @0
REQUIRE_PREDICATE GAME_IS ~tob bg2ee eet bgt~ @5

OUTER_SET WarslingSniperKit = 2

INCLUDE ~WarslingSniperKit/lib/WarslingSniperKit.tpa~


BEGIN @8
DESIGNATED 3
LABEL ~Adam_Zsoldos_WarslingSniperKit-Multi_Fault~
SUBCOMPONENT @0
REQUIRE_PREDICATE GAME_IS ~tob bg2ee eet bgt~ @5

OUTER_SET WarslingSniperKit = 3

INCLUDE ~WarslingSniperKit/lib/WarslingSniperKit.tpa~


BEGIN @9
DESIGNATED 4
LABEL ~Adam_Zsoldos_WarslingSniperKit-All~
SUBCOMPONENT @0
REQUIRE_PREDICATE GAME_IS ~tob bg2ee eet bgt~ @5

OUTER_SET WarslingSniperKit = 4

INCLUDE ~WarslingSniperKit/lib/WarslingSniperKit.tpa~




BEGIN ~Jaheira the warsling sniper~
DESIGNATED 5
LABEL ~Adam_Zsoldos_WarslingSniperKit-Jaheira~
REQUIRE_PREDICATE GAME_IS ~tob bgee bg2ee eet bgt~ @5

// Borrowed from Charlatan Kit by Raduziel

COPY_EXISTING ~kitlist.2da~ ~override~
  COUNT_2DA_ROWS ~9~ "rows"
  FOR ( index = 31 ; index < rows ; index = index + 1 ) BEGIN
    READ_2DA_ENTRY "%index%" 5 9 "clab"
    PATCH_IF ("%clab%" STRING_COMPARE_CASE "A0WS" = 0) BEGIN
      READ_2DA_ENTRY "%index%" 0 9 "A0WS"
      SET "rows" = 0
    END
  END
  BUT_ONLY_IF_IT_CHANGES

OUTER_SET kit_Jaheira = "%A0WS%"

//												Regular
ACTION_FOR_EACH creature IN JAHEI12B JAHEI14 JAHEIR JAHEIR11 JAHEIR12 JAHEIR2 JAHEIR4 JAHEIR6 JAHEIR7 JAHEIR_7 JAHEIR8 JAHEIRD BEGIN

	ACTION_IF FILE_EXISTS_IN_GAME ~%creature%.cre~ THEN BEGIN
PRINT ~Jaheira Exists~
		COPY_EXISTING ~%creature%.cre~ ~override~
			WRITE_SHORT 0x244 0
			WRITE_SHORT 0x246 0x4000 + kit_Jaheira
      BUT_ONLY

	END
END


