@7 = ~Ajouter seulement : Abondance de ricochets une nouvelle capacité passive à partir du 24ème niveau~

// composant 4 (3)
@8 = ~Abondance de ricochets :  Ajouter 5 % de chance que l'un des ricochets touche un allié à proximité~

// composant 4 (2)
@9 = ~Apprentissage progressif des ricochets : Ajouter un pourcentage de chance que l'un des ricochets touche un allié dans la mêlé~

@10 = ~Capacité : Ricochet~
@11 = ~Capacité : Abondance de ricochets~

@12 = ~Capacité : Chance d'effectuer un second ricochet~
@13 = ~Capacité : Chance d'effectuer un troisième ricochet~
@14 = ~Capacité : Chance d'effectuer un quatrième ricochet~
